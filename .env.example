# Copy to .env and replace every value. Generate each secret with:
#   openssl rand -base64 32
# Nothing here has a default: a missing value stops `docker compose up`.

POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
API_DB_PASSWORD=
BETTER_AUTH_SECRET=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# The URLs a browser uses to reach Web and Auth. Web and Auth must share a
# site, such as app.example.com and auth.example.com, so Auth's session cookie
# reaches Auth from Web's pages.
WEB_URL=http://localhost:3000
AUTH_URL=http://localhost:3001
