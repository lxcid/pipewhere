# Copy to .env and replace every value. Generate each secret with:
#   openssl rand -hex 24
# Use hex: the database passwords go into connection URLs as they are, and a
# base64 value can hold a "/" that breaks the URL.
# Nothing here has a default: a missing value stops `docker compose up`.

POSTGRES_PASSWORD=
AUTH_DB_PASSWORD=
API_DB_PASSWORD=
BETTER_AUTH_SECRET=
RUSTFS_ACCESS_KEY=
RUSTFS_SECRET_KEY=

# Encrypts the provider credentials API stores. It is 32 bytes, so generate it
# with `openssl rand -hex 32`. Keep it with your database backups: without it,
# every connected channel must be connected again.
CREDENTIALS_KEY=

# The URLs a browser uses to reach Web and Auth. Web and Auth must share a
# site, such as app.example.com and auth.example.com, so Auth's session cookie
# reaches Auth from Web's pages.
WEB_URL=http://localhost:3000
AUTH_URL=http://localhost:3001
# The URL a browser uses to reach API. Web's pages call it directly.
API_URL=http://localhost:3002
