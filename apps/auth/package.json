{
  "name": "@pipewhere/auth",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "migrate": "node src/migrate.ts",
    "test": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "test:db": "docker run --rm -d --name pipewhere-test-postgres -e POSTGRES_PASSWORD=test -p 127.0.0.1:5433:5432 --tmpfs /var/lib/postgresql postgres:18.6"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.12",
    "@hono/node-server": "2.1.5",
    "better-auth": "1.7.12",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "typeid-js": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "jose": "6.2.13",
    "typescript": "7.0.2"
  }
}
